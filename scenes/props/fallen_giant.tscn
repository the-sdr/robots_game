[gd_scene format=3]

; Placeholder for "The Fallen Giant" - a colossal dead machine slumped across
; the stream. Local X runs along the body (head at -X, legs at +X), origin at
; stream-bed level under the raised middle. The middle hull section is lifted
; 2.4 m so the stream bed passes beneath it. Built from primitives so parts can
; be swapped for final art individually.

[sub_resource type="StandardMaterial3D" id="Mat_rust"]
albedo_color = Color(0.43, 0.31, 0.23, 1)
metallic = 0.5
roughness = 0.8

[sub_resource type="StandardMaterial3D" id="Mat_dark"]
albedo_color = Color(0.2, 0.21, 0.23, 1)
metallic = 0.6
roughness = 0.6

[sub_resource type="StandardMaterial3D" id="Mat_moss"]
