; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Robots_game_godotfile"
config/name.macos="Robots Beta"
config/name.ios="Robots Beta"
config/name.robots_beta="Robots Beta"
config/windows_native_icon="res://icon_app.ico"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
config/macos_native_icon=""
config/version="0.1.0"

[autoload]

Catalog="*res://scripts/game/catalog.gd"
Clock="*res://scripts/game/clock.gd"
Energy="*res://scripts/game/energy.gd"
Game="*res://scripts/game/game.gd"
Story="*res://scripts/game/story.gd"
Settings="*res://scripts/game/settings.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

